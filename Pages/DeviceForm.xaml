<Page x:Class="pract7.Pages.DeviceForm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DeviceForm">
    <Grid>
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Click="BackButton_Click">Назад</Button>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="250">
            <TextBlock>Название</TextBlock>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ></TextBox>
            <TextBlock>Мануфактура</TextBlock>
            <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <TextBlock>Цена</TextBlock>
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <TextBlock>Количество</TextBlock>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}">Активно</CheckBox>
            <Button Click="SaveButton_Click">Сохранить</Button>
        </StackPanel>
    </Grid>
</Page>
