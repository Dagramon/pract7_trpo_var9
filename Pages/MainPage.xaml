<Page x:Class="pract7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="Главная страница">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="5" Width="200" Click="Button_Click">Создать новую запись</Button>
            <Button Margin="5" Width="200">Изменить запись</Button>
            <Button Margin="5" Width="200">Удалить запись</Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5" HorizontalAlignment="Center">
            <TextBlock>Фильтрация по мануфактуре</TextBlock>
            <TextBox></TextBox>
            <TextBlock>Фильтрация по минимальной цене</TextBlock>
            <TextBox></TextBox>
        </StackPanel>
        <ListView Grid.Column="1" Grid.Row="1"
                  x:Name="DeviceList"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding devices}">
            <ListView.ItemTemplate>
                <DataTemplate>
                   
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
